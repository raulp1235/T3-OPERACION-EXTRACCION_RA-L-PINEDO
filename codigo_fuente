function centerAndScale(obj, target) {
  obj.updateMatrixWorld(true);
  const box = new THREE.Box3().setFromObject(obj), size = box.getSize(new THREE.Vector3()), ctr = box.getCenter(new THREE.Vector3());
  obj.position.sub(ctr);
  const wrap = new THREE.Group(); wrap.add(obj);
  wrap.scale.setScalar(target / Math.max(size.x, size.y, size.z));
  return wrap;
}
function buildWeapons() {
  const ak = centerAndScale(gltfs.ak.scene, 0.62);
  const akPivot = new THREE.Group(); ak.rotation.y = Math.PI / 2; akPivot.add(ak);
  akPivot.position.set(0.2, -0.2, -0.45);
  const sn = centerAndScale(gltfs.sniper.scene, 0.95);
  const snPivot = new THREE.Group(); sn.rotation.y = Math.PI / 2; snPivot.add(sn);
  snPivot.position.set(0.2, -0.22, -0.7);
  for (const p of [akPivot, snPivot]) { p.traverse(o => { if (o.isMesh) o.frustumCulled = false; }); hand.add(p); }
  weapons.push({ key: 'ak', name: 'AK-47', pivot: akPivot, base: akPivot.position.clone() },
               { key: 'sniper', name: 'SNIPER', pivot: snPivot, base: snPivot.position.clone() });
}


const zombies = [];
const hitboxes = [];
const ZOMBIE_SPAWNS = [[-10,72,'pvz'],[12,68,'pvz'],[0,45,'mutant'],[-12,40,'pvz'],[14,30,'pvz'],[-6,15,'pvz'],[8,8,'mutant'],[-14,-2,'pvz'],
  [5,-20,'pvz'],[-8,-28,'mutant'],[12,-38,'pvz'],[-12,-52,'pvz'],[0,-58,'mutant'],[10,-68,'pvz'],[-10,-72,'pvz'],[3,-85,'mutant'],[-8,-88,'pvz']];

function spawnZombie(x, z, type) {
  const T = ZTYPES[type], g = gltfs[type];
  const model = SkeletonUtils.clone(g.scene);
  const mats = [];
  model.traverse(o => {
    if (o.isMesh) { o.frustumCulled = false; o.material = o.material.clone(); mats.push(o.material); }
  });
  const holder = new THREE.Group(); holder.scale.setScalar(T.scale); holder.rotation.y = T.flip; holder.add(model);
  const root = new THREE.Group(); root.rotation.order = 'YXZ'; root.position.set(x, 0, z); root.rotation.y = Math.random() * 6.28; root.add(holder);
  const hit = new THREE.Mesh(new THREE.CylinderGeometry(T.hitR, T.hitR, T.hitH, 10), new THREE.MeshBasicMaterial({ visible: false }));
  hit.position.y = T.hitH / 2; root.add(hit);
  scene.add(root);
  const zb = { type, T, root, holder, hit, hp: CFG.zombieHP, state: 'idle', mats, flashT: 0, deadT: 0, t: Math.random() * 10, mixer: null, actions: {}, cur: null };
  hit.userData.zombie = zb;
  if (g.animations.length) {          
    zb.mixer = new THREE.AnimationMixer(model);
    for (const c of g.animations) zb.actions[c.name] = zb.mixer.clipAction(c);
    play(zb, 'Idle');
  }
  zombies.push(zb); hitboxes.push(hit);
}
function play(zb, name) {
  const a = zb.actions[name]; if (!a || zb.cur === a) return;
  a.reset().fadeIn(0.25).play(); if (zb.cur) zb.cur.fadeOut(0.25); zb.cur = a;
  if (name === 'Walk') a.timeScale = 1.2;
}

