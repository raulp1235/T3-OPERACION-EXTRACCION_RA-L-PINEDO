function setWeapon(i) { cur = i; zoom = false; weapons.forEach((w, k) => { w.pivot.visible = k === i; w.pivot.rotation.set(0, 0, 0); w.pivot.position.copy(w.base); }); hud(); }

const SND = {};
for (const n of ['ak_shot', 'sniper_shot', 'empty', 'pickup', 'hit']) { SND[n] = new Audio(`assets/sounds/${n}.wav`); SND[n].preload = 'auto'; }
function playSound(name, vol = 1) {
  const base = SND[name]; if (!base) return;
  const a = base.cloneNode();            
  a.volume = vol; a.play().catch(() => {});
}


const ray = new THREE.Raycaster();
function fire() {
  const w = weapons[cur], k = w.key;
  if (cd > 0) return;
  if (ammo[k] <= 0) { toast('SIN MUNICIÓN', 900); playSound('empty'); return; }  
  ammo[k]--; cd = CFG.cooldown[k]; hud();
  kick = k === 'ak' ? 1 : 2.5; muzzle.intensity = k === 'ak' ? 25 : 45;
  playSound(k === 'ak' ? 'ak_shot' : 'sniper_shot');               
  ray.setFromCamera(new THREE.Vector2(0, 0), camera);
  ray.far = CFG.range[k];
  const hits = ray.intersectObjects([...hitboxes, ...wallMeshes], false);
  if (!hits.length) return;
  const z = hits[0].object.userData.zombie;          
  if (z && z.hp > 0) hitZombie(z);
}
function hitZombie(z) {
  z.hp--; z.flashT = 0.15; playSound('hit', 0.7);
  if (z.state === 'idle') z.state = 'chase';        
  if (z.hp <= 0) killZombie(z);
}
function killZombie(z) {
  z.state = 'dead'; z.hp = 0; kills++;
  hitboxes.splice(hitboxes.indexOf(z.hit), 1);       
  if (z.mixer) z.mixer.stopAllAction();
  hud();
}


const clock = new THREE.Clock();
const tmp = new THREE.Vector3();

function update(dt) {
  if (cd > 0) cd -= dt;
  const spd = CFG.playerSpeed * (player.boost > 0 ? CFG.boostMult : 1);
  const fx = -Math.sin(player.yaw), fz = -Math.cos(player.yaw), rx = Math.cos(player.yaw), rz = -Math.sin(player.yaw);
  let mx = 0, mz = 0;
  if (keys.KeyW) { mx += fx; mz += fz; } if (keys.KeyS) { mx -= fx; mz -= fz; }
  if (keys.KeyD) { mx += rx; mz += rz; } if (keys.KeyA) { mx -= rx; mz -= rz; }
  const len = Math.hypot(mx, mz), moving = len > 0;
  if (moving) { player.pos.x += mx / len * spd * dt; player.pos.z += mz / len * spd * dt; }
  resolve(player.pos, CFG.playerRadius);
  if (player.boost > 0) player.boost = Math.max(0, player.boost - dt);
  const bobT = performance.now() / 1000;
  camera.position.set(player.pos.x, 1.7 + (moving ? Math.sin(bobT * 10) * 0.035 : 0), player.pos.z);
  camera.rotation.set(player.pitch, player.yaw, 0);
  camera.fov += ((zoom && cur === 1 ? 26 : 75) - camera.fov) * Math.min(1, dt * 12); camera.updateProjectionMatrix();   // zoom del sniper

  const w = weapons[cur];
  w.pivot.position.set(w.base.x + (moving ? Math.sin(bobT * 5) * 0.008 : 0), w.base.y + (moving ? Math.abs(Math.sin(bobT * 10)) * 0.012 : 0), w.base.z + kick * 0.06);
  w.pivot.rotation.x = kick * 0.12;
  kick = Math.max(0, kick - dt * 9); muzzle.intensity *= 0.6;
  w.pivot.visible = !(zoom && cur === 1);  

  for (const p of pickups) {
    if (!p.m.visible) continue;
    p.m.rotation.y += dt * 2; p.m.position.y = 0.75 + Math.sin(bobT * 3 + p.m.position.x) * 0.1;
    if (Math.hypot(p.m.position.x - player.pos.x, p.m.position.z - player.pos.z) < 1.4) {
      p.m.visible = false;
      if (p.type === 'ammo') { ammo.ak += CFG.pickupAmmo.ak; ammo.sniper += CFG.pickupAmmo.sniper; toast(`+${CFG.pickupAmmo.ak} balas AK · +${CFG.pickupAmmo.sniper} balas sniper`); }
      else { player.boost = CFG.boostTime; toast('¡VELOCIDAD EXTRA!'); }
      playSound('pickup'); hud();
    }
  }


  for (const z of zombies) {
    z.t += dt;
    if (z.flashT > 0) { z.flashT -= dt; for (const m of z.mats) m.emissive?.setRGB(z.flashT > 0 ? 0.8 : 0, 0, 0); }
    if (z.state === 'dead') {                      
      z.deadT = Math.min(1, z.deadT + dt * 2.2);
      z.root.rotation.x = -Math.PI / 2 * z.deadT; 
      continue;
    }
    if (z.mixer) z.mixer.update(dt);
    const dx = player.pos.x - z.root.position.x, dz = player.pos.z - z.root.position.z, dist = Math.hypot(dx, dz);
    if (z.state === 'idle') {
      if (dist < CFG.detectRange) { z.state = 'chase'; play(z, 'Walk'); toast('¡Un zombi te ha detectado!', 900); }   // RF05
      else { z.holder.rotation.z = Math.sin(z.t * 1.6) * 0.03; continue; }
    }

    play(z, 'Walk');
    z.root.rotation.y = Math.atan2(dx, dz);
    z.root.position.x += dx / dist * z.T.speed * dt; z.root.position.z += dz / dist * z.T.speed * dt;
    resolve(z.root.position, 0.5);
    if (!z.mixer) { z.holder.position.y = Math.abs(Math.sin(z.t * 9)) * 0.08; z.holder.rotation.z = Math.sin(z.t * 9) * 0.08; }
    if (dist < z.T.catchDist) return gameOver();     
  }

  for (let i = 0; i < zombies.length; i++) for (let j = i + 1; j < zombies.length; j++) {
    const a = zombies[i], b = zombies[j]; if (a.state !== 'chase' || b.state !== 'chase') continue;
    tmp.subVectors(a.root.position, b.root.position); tmp.y = 0; const d = tmp.length();
    if (d < 1 && d > 0.001) { tmp.multiplyScalar((1 - d) / d * 0.5); a.root.position.add(tmp); b.root.position.sub(tmp); }
  }


  const de = Math.hypot(player.pos.x - EXTRACT.x, player.pos.z - EXTRACT.z);
  $('dist').textContent = Math.max(0, de - EXTRACT_R).toFixed(0);
  if (de < EXTRACT_R) win();
}

function gameOver() {
  if (state !== 'playing') return;
  state = 'dead'; document.exitPointerLock(); $('dmg').style.opacity = 1; $('over').classList.remove('hidden');
}
function win() {
  if (state !== 'playing') return;
  state = 'won'; document.exitPointerLock(); $('win').classList.remove('hidden');
}

renderer.setAnimationLoop(() => {
  const dt = Math.min(clock.getDelta(), 0.05);
  if (state === 'playing' && document.pointerLockElement) update(dt);
  else if (state === 'menu') { camera.position.set(0, 1.7, 96); camera.rotation.set(0, 0, 0); }
  exPad.material.opacity = 0.35 + Math.sin(performance.now() / 400) * 0.15;
  renderer.render(scene, camera);
});


addEventListener('keydown', e => {
  keys[e.code] = true;
  if (state === 'playing') { if (e.code === 'Digit1') setWeapon(0); if (e.code === 'Digit2') setWeapon(1); }
  if (e.code === 'KeyR' && (state === 'dead' || state === 'won')) location.reload();
});
addEventListener('keyup', e => keys[e.code] = false);
addEventListener('mousemove', e => {
  if (state !== 'playing' || !document.pointerLockElement) return;
  const sens = zoom && cur === 1 ? 0.0009 : 0.0022;
  player.yaw -= e.movementX * sens;
  player.pitch = Math.max(-1.4, Math.min(1.4, player.pitch - e.movementY * sens));
});

addEventListener('mousedown', e => {
  if (state !== 'playing' || !document.pointerLockElement) return;
  if (e.button === 0) fire();
  if (e.button === 2 && cur === 1) zoom = !zoom;      
});
addEventListener('contextmenu', e => e.preventDefault());
document.addEventListener('pointerlockchange', () => {
  if (state === 'playing') $('pause').classList.toggle('hidden', !!document.pointerLockElement);
});
$('pause').addEventListener('click', () => renderer.domElement.requestPointerLock());
$('retry').onclick = $('again').onclick = () => location.reload();
$('play').onclick = () => {
  state = 'playing'; $('menu').classList.add('hidden'); $('hud').classList.remove('hidden');
  renderer.domElement.requestPointerLock(); hud(); toast('Llega a la zona verde de extracción', 2500);
};


(async () => {
  try {
    const [ak, sniper, pvz, mutant] = await Promise.all([load('ak47.glb'), load('sniper.glb'), load('zombie_pvz.glb'), load('zombie_mutant.glb')]);
    gltfs = { ak, sniper, pvz, mutant };
    buildWeapons(); setWeapon(0);
    ZOMBIE_SPAWNS.forEach(([x, z, t]) => spawnZombie(x, z, t));
    $('play').disabled = false; $('play').textContent = 'JUGAR'; $('total').textContent = zombies.length;
  } catch (err) {
    console.error(err);
    $('play').textContent = 'Error al cargar';
    $('loadmsg').textContent = 'No se pudieron cargar los modelos. Abre el juego con un servidor local (no con doble clic en index.html). ' + err.message;
  }
})();
