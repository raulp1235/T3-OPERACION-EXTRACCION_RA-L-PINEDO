function addBox(x, z, w, d, h, color, solid = true) {
  const m = new THREE.Mesh(new THREE.BoxGeometry(w, h, d), new THREE.MeshStandardMaterial({ color, roughness: 0.9 }));
  m.position.set(x, h / 2, z); scene.add(m);
  if (solid) { colliders.push({ minX: x - w / 2, maxX: x + w / 2, minZ: z - d / 2, maxZ: z + d / 2 }); wallMeshes.push(m); }
  return m;
}

function groundTexture() {
  const c = document.createElement('canvas'); c.width = c.height = 256;
  const g = c.getContext('2d'); g.fillStyle = '#2b2f33'; g.fillRect(0, 0, 256, 256);
  for (let i = 0; i < 2500; i++) { const v = 35 + Math.random() * 30 | 0; g.fillStyle = `rgb(${v},${v + 3},${v + 6})`; g.fillRect(Math.random() * 256, Math.random() * 256, 2, 2); }
  g.strokeStyle = '#555'; g.lineWidth = 2; g.strokeRect(0, 0, 256, 256);
  const t = new THREE.CanvasTexture(c); t.wrapS = t.wrapT = THREE.RepeatWrapping; t.repeat.set(14, 55); t.colorSpace = THREE.SRGBColorSpace;
  return t;
}
function windowTexture() {
  const c = document.createElement('canvas'); c.width = 128; c.height = 256;
  const g = c.getContext('2d'); g.fillStyle = '#1a1d22'; g.fillRect(0, 0, 128, 256);
  for (let y = 10; y < 250; y += 28) for (let x = 10; x < 120; x += 26) {
    g.fillStyle = Math.random() < 0.12 ? '#c9a24a' : '#0c0e11'; g.fillRect(x, y, 14, 18);
  }
  const t = new THREE.CanvasTexture(c); t.colorSpace = THREE.SRGBColorSpace; return t;
}

